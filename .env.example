# Vorlage für lokale Zugangsdaten.
# Kopieren nach .env (wird nicht committet) und Werte eintragen:
#   cp .env.example .env

# renewables.ninja API-Token, benötigt von Cost_analysis/re_data.py
# Eigenen Token erstellen unter: https://www.renewables.ninja/profile
RENEWABLES_NINJA_TOKEN=

# CARTO-API-Key für die Hintergrundkarten (CartoDB.Positron) in den Kartenskripten
# Key anfordern unter: https://carto.com/basemaps/apikey/
CARTO_API_KEY=
